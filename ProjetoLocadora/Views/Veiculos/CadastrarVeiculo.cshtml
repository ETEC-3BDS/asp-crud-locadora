@model ProjetoLocadora.Models.Veiculo

@{
    ViewData["Title"] = "Cadastrar Veículo";
}

<h2>Cadastrar Veículo</h2>

<form asp-action="CadastrarVeiculo" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="Modelo"></label>
        <input asp-for="Modelo" class="form-control" />
        <span asp-validation-for="Modelo" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Placa"></label>
        <input asp-for="Placa" class="form-control" />
        <span asp-validation-for="Placa" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Ano"></label>
        <input asp-for="Ano" class="form-control" type="number" />
        <span asp-validation-for="Ano" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>